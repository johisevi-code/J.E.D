fun loadJSONFromN9(context: Context): String? {
    return try {
        // Abre el archivo desde la ruta específica
        val inputStream = context.assets.open("n9/config.json")
        val size = inputStream.available()
        val buffer = ByteArray(size)
        inputStream.read(buffer)
        inputStream.close()
        String(buffer, Charsets.UTF_8)
    } catch (ex: IOException) {
        ex.printStackTrace()
        null // Aquí es donde la app se pone en blanco si no encuentra el archivo
    }
}
# Crear la carpeta n9 si no existe
mkdir -p app/src/main/assets/n9

